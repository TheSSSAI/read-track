{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend: ReadTrack.Host",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/backend/src/ReadTrack.Host/bin/Debug/net8.0/ReadTrack.Host.dll",
            "args": [],
            "cwd": "${workspaceFolder}/backend/src/ReadTrack.Host",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": "Mobile: Flutter",
            "type": "dart",
            "request": "launch",
            "program": "mobile/lib/main.dart",
            "cwd": "mobile",
            "flutterMode": "debug"
        },
        {
            "name": "Docker: Compose Up",
            "type": "docker",
            "request": "launch",
            "preLaunchTask": "docker-compose: up",
            "dockerServerReadyAction": {
                "action": "openExternally",
                "pattern": "Now listening on: (https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "python": {
                "args": [],
                "path": ""
            }
        }
    ],
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/backend/src/ReadTrack.Host/ReadTrack.Host.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "docker-compose: up",
            "type": "shell",
            "command": "docker-compose -f backend/docker-compose.yml up -d --build",
            "presentation": {
                "reveal": "always"
            }
        }
    ]
}