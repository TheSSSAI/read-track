{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    }
  },
  "AllowedOrigins": {
    "Urls": [
      "http://localhost:3000",
      "http://localhost:4200",
      "https://localhost:7001",
      "http://localhost:5000"
    ]
  },
  "Auth0": {
    "Domain": "dev-readtrack.auth0.com",
    "Audience": "https://api.readtrack.dev"
  }
}