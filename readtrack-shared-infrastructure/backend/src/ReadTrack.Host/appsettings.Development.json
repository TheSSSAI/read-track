{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "ReadTrack": "Debug"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=readtrack-db;Port=5432;Database=readtrack;Username=postgres;Password=postgres_dev_password",
    "RedisConnection": "readtrack-redis:6379"
  },
  "Resilience": {
    "RetryCount": 3,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerDurationSeconds": 30
  },
  "Hangfire": {
    "UseMemoryStorage": false,
    "WorkerCount": 5
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  },
  "AllowedHosts": "*"
}